# Configuração do servidor do Riverfront. Copie para .env e ajuste.
# Nada aqui é segredo; não coloque senhas ou tokens neste arquivo de exemplo.

# Porta HTTP/WebSocket. O jogo conecta em ws://<endereço>:PORT/ws
PORT=8787
# 0.0.0.0 aceita conexões de outras máquinas; 127.0.0.1 só desta.
HOST=0.0.0.0

# Pasta onde ficam contas, partidas e denúncias (JSON/NDJSON).
# Use DATA_DIR=memoria para não gravar nada em disco.
DATA_DIR=./dados

# Pasta com o cliente web compilado. Com ela, http://<endereço>:PORT/ abre o jogo
# e o link de convite (#sala=XXXX-XX) funciona direto no navegador.
CLIENT_DIR=./public

# Logs em arquivo (um por dia). O IP só aparece nos arquivos e é apagado após 7 dias.
# Deixe vazio para logar só no console.
LOG_DIR=./logs
LOG_LEVEL=info

# Origens permitidas para o WebSocket, separadas por vírgula. Vazio ou * aceita todas.
# Exemplo: https://riverfront.exemplo.com.br,riverfront://app
ALLOWED_ORIGINS=
# Aceitar clientes sem cabeçalho Origin (ferramentas, testes)?
ALLOW_NO_ORIGIN=true

MAX_CONNECTIONS=2000
MAX_CONNECTIONS_PER_IP=20

# Atrás de um proxy reverso seu (nginx, Caddy): true usa o ÚLTIMO IP do X-Forwarded-For
# (o que o proxy acrescentou); cloudflare usa o CF-Connecting-IP (túnel da Cloudflare).
TRUST_PROXY=false

# Contas anônimas: novas por IP e por hora, teto total e dias sem acesso até expirar.
ACCOUNTS_PER_IP_HOUR=20
MAX_ACCOUNTS=200000
ACCOUNT_INACTIVE_DAYS=365

# Retenção (dias): denúncias, partidas encerradas e arquivos de log.
REPORT_RETENTION_DAYS=90
MATCH_RETENTION_DAYS=90
LOG_RETENTION_DAYS=30
